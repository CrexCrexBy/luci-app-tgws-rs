msgstr "Распаковка архива"

msgid "Fetch and use the Cloudflare proxy domain list from GitHub (no domain setup needed)."
msgstr "Взять и использовать список доменов Cloudflare-прокси с GitHub (настройка доменов не требуется)."

msgid "Generate"
msgstr "Сгенерировать"

msgid "Generate proxy links/QR with the router hostname instead of the LAN IP."
msgstr "Генерировать ссылки/QR прокси с именем роутера вместо IP-адреса LAN."

msgid "Hostname or IP address to bind to."
msgstr "Имя хоста или IP-адрес для привязки."

