msgstr "Примерно до какого размера может вырасти журнал, прежде чем старые строки будут обрезаны. Можно ввести своё значение в байтах."

msgid "Round-robin across multiple Cloudflare proxy domains instead of always trying the same one first."
msgstr "Перебирать несколько доменов Cloudflare-прокси по кругу, а не всегда пробовать сначала один и тот же."

msgid "Route connections through Cloudflare."
msgstr "Направлять соединения через Cloudflare."

msgid "Secret"
msgstr "Секрет"

msgid "Settings"
msgstr "Настройки"

msgid "Shared secret for proxy authentication."
msgstr "Общий секрет для аутентификации прокси."

msgid "Show link & QR-code..."
msgstr "Показать ссылку и QR-код..."

msgid "Showing cached release list (no internet connection at last check)."
msgstr "Показывается кэшированный список релизов (при последней проверке не было интернета)."

msgid "Socket buffer size in kilobytes."
msgstr "Размер буфера сокета в килобайтах."

msgid "Software Update"
msgstr "Обновление ПО"

msgid "Start"
msgstr "Запустить"

msgid "Status"
msgstr "Статус"

