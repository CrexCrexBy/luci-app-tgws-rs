msgstr "Прокси Telegram WebSocket"

msgid "A Rust-based WebSocket proxy for Telegram with Cloudflare support."
msgstr "WebSocket-прокси для Telegram на Rust с поддержкой Cloudflare."

msgid "TGWS: autostart off"
msgstr "TGWS: нет автозапуска"

msgid "TGWS: autostart on"
msgstr "TGWS: автозапуск"

msgid "TGWS: running"
msgstr "TGWS: работает"

msgid "TGWS: stopped"
msgstr "TGWS: остановлен"

msgid "The worker domain used for the Cloudflare route."
msgstr "Домен Worker для маршрута через Cloudflare."

msgid "Update installed"
msgstr "Обновление установлено"

