msgstr "Использовать маршрут через Cloudflare как основной."

msgid "Main log"
msgstr "Основной журнал"

msgid "Version"
msgstr "Версия"

msgid "Watchdog Auto-start disabled"
msgstr "Автозапуск сторожа отключён"

msgid "Watchdog Auto-start enabled"
msgstr "Автозапуск сторожа включён"

msgid "Watchdog enable autostart"
msgstr "Включить автозапуск сторожа"

msgid "Watchdog check interval"
msgstr "Интервал проверки сторожа"

msgid "How often the watchdog probes Cloudflare domains when running in the background. Shorter intervals recover faster but restart the service more often."
msgstr "Как часто сторож проверяет домены Cloudflare в фоне. Меньший интервал быстрее восстанавливает связь, но чаще перезапускает службу."

msgid "10 minutes"
msgstr "10 минут"

