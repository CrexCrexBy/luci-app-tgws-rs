msgstr "Переопределить имя хоста, используемое в ссылке на прокси."

msgid "Page %d of %d"
msgstr "Страница %d из %d"

msgid "Path to the log file used by the proxy."
msgstr "Путь к файлу журнала, используемому прокси."

msgid "Path to the watchdog log file. The file is created automatically on the first watchdog run."
msgstr "Путь к файлу журнала сторожа. Файл создаётся автоматически при первом запуске сторожа."

msgid "Prefer Cloudflare connection"
msgstr "Предпочитать соединение через Cloudflare"

msgid "Previous"
msgstr "Назад"

