msgstr "Вести отдельный файл журнала для сторожа доменов."

msgid "Latest releases from GitHub."
msgstr "Последние релизы с GitHub."

msgid "Let the watchdog automatically enable or disable the Cloudflare worker based on its health. Disable to keep manual control."
msgstr "Разрешить сторожу автоматически включать/отключать Cloudflare Worker по его состоянию. Отключите для ручного управления."

msgid "List of Telegram datacenter IPs, one per line."
msgstr "Список IP-адресов дата-центров Telegram, по одному на строку."

