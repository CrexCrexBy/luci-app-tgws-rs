msgid "-- custom --"
msgstr "-- свой --"

msgid "Automatically filled by the watchdog from its health checks (healthy-then-fallback order). Read-only — to manage manually, stop the watchdog first."
msgstr "Автоматически заполняется сторожем по результатам проверок здоровья (сначала рабочие, затем резервные). Только чтение — для ручного управления сначала остановите сторожа."

msgid "Balance connections across Cloudflare domains"
msgstr "Балансировать соединения между доменами Cloudflare"

msgid "Buffer size (KB)"
msgstr "Размер буфера (КБ)"

msgid "Close"
msgstr "Закрыть"

msgid "Cloudflare proxy domains (auto)"
msgstr "Домены Cloudflare-прокси (авто)"

msgid "Cloudflare worker domain"
msgstr "Домен Cloudflare Worker"

msgid "Connection pool size"
msgstr "Размер пула соединений"

msgid "Custom link host"
msgstr "Свой хост для ссылки"

msgid "Datacenter IPs"
msgstr "IP-адреса дата-центров"

msgid "Disable auto-start"
msgstr "Отключить автозапуск"

msgid "Downloading %s"
msgstr "Загрузка %s"

msgid "Enable auto-start"
msgstr "Включить автозапуск"

msgid "Enable Cloudflare-proxied connection"
msgstr "Использовать соединение через Cloudflare"

msgid "Enable the Cloudflare worker route. Toggled automatically by the watchdog based on worker health."
msgstr "Включить маршрут через Cloudflare Worker. Переключается сторожем автоматически по состоянию Worker."

