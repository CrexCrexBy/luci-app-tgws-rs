#!/bin/sh
#
# tgws-watchdog — health-check for tg-ws-proxy Cloudflare domains.
# Runs periodically from cron. Probes every CF domain via `--check`,
# writes only the healthy ones (bare domains, kws prefix stripped,
# since --cf-domain expects the plain domain and the proxy builds
# kws{N}.{domain} itself) into uci `settings.cf_domain`, keeps
# `default_domains` as a fallback list, and restarts the service when
# the healthy set changes or the previous run left domains failing.
#
# Exit codes:
#   0 — all domains healthy, nothing changed
#   1 — regressions detected, health set updated / service restarted
#   2 — all domains failing (config left as-is)
#   3 — --check itself failed (binary or network problem)
#
# Config (uci, package tgws, section settings):
#   watchdog_enabled   '0'|'1'  master switch (default '1')
#   watchdog_keep      count    max healthy domains to store in cf_domain
#                               (default 5)
#   watchdog_log       '0'|'1'  keep a watchdog log file (default '1')
#   watchdog_log_file  path     watchdog log path (default '/var/log/tgws-watchdog.log')
#   log_max_size       bytes    trim logs once they exceed this size (default 1M)
#   watchdog_worker    '0'|'1'  allow the watchdog to auto-toggle cf_worker_enabled
#                               based on the worker health (default '1')

WD_LOG="$(uci -q get tgws.settings.watchdog_log_file)"
[ -z "$WD_LOG" ] && WD_LOG="/var/log/tgws-watchdog.log"
LOGFILE="$WD_LOG"
LOG_MAX="$(uci -q get tgws.settings.log_max_size || echo 1048576)"
case "$LOG_MAX" in
    ''|*[!0-9]*) LOG_MAX=1048576 ;;
esac
MAX_KEEP="$(uci -q get tgws.settings.watchdog_keep || echo 5)"
case "$MAX_KEEP" in
    ''|*[!0-9]*) MAX_KEEP=5 ;;
esac
WD_WORKER="$(uci -q get tgws.settings.watchdog_worker || echo 1)"
case "$WD_WORKER" in
    0|false) WD_WORKER=0 ;;
    *)        WD_WORKER=1 ;;
esac

log() {
    echo "$(date '+%F %T') $*" >> "$LOGFILE"
}

# create the watchdog log file up front (recursive mkdir is for old paths)
ensure_log() {
    [ "$(uci -q get tgws.settings.watchdog_log || echo 1)" = "1" ] || return 0
    [ -n "$LOGFILE" ] || return 0
    mkdir -p "${LOGFILE%/$(basename "$LOGFILE")}" 2>/dev/null
    [ -e "$LOGFILE" ] || touch "$LOGFILE"
}

# trim files that grew past the limit (keep up to the last 1000 lines)
trim_log() {
    f="$1"
    [ -n "$f" ] && [ -f "$f" ] || return 0
    [ "$LOG_MAX" -gt 0 ] || return 0
    size=$(wc -c < "$f")
    if [ "$size" -gt "$LOG_MAX" ]; then
        tmp="${f}.trim.$$"
        tail -n 1000 "$f" > "$tmp" 2>/dev/null && mv -f "$tmp" "$f"
        log "INFO trimmed $f ($size -> $(wc -c < "$f") bytes)"
    fi
}

# collect healthy kws domains from --check output
probe() {
    tg-ws-proxy --check --default-domains 2>&1
}

# probe the worker: any HTTP response (2xx/3xx/4xx/5xx) means the worker is
# reachable and routes to our proxy; a connection error means it is down.
probe_worker() {
    domain="$1"
    [ -n "$domain" ] || return 2
    code=$(curl -sS -o /dev/null --max-time 8 -w '%{http_code}' "https://$domain/apiws" 2>/dev/null)
    case "$code" in
        ''|000) return 1 ;;
        *)      return 0 ;;
    esac
}

# toggle cf_worker_enabled and restart the service if the flag flipped
manage_worker() {
    [ "$WD_WORKER" = "1" ] || return 0
    domain="$(uci -q get tgws.settings.cf_worker_domain)"
    [ -n "$domain" ] || return 0
    cur="$(uci -q get tgws.settings.cf_worker_enabled || echo 0)"
    if probe_worker "$domain"; then
        if [ "$cur" != "1" ]; then
            uci set tgws.settings.cf_worker_enabled=1
            uci commit tgws
            log "INFO worker $domain healthy, cf_worker_enabled 0 -> 1, restart"
            /etc/init.d/tgws restart >/dev/null 2>&1
        else
            log "INFO worker $domain healthy, already enabled"
        fi
    else
        if [ "$cur" = "1" ]; then
            uci set tgws.settings.cf_worker_enabled=0
            uci commit tgws
            log "INFO worker $domain unreachable, cf_worker_enabled 1 -> 0, restart"
            /etc/init.d/tgws restart >/dev/null 2>&1
        else
            log "INFO worker $domain unreachable, already disabled"
        fi
    fi
}

main() {
    ensure_log

    trim_log "$LOGFILE"
    main_log="$(uci -q get tgws.settings.log_file)"
    [ -n "$main_log" ] && trim_log "$main_log"

    [ "$(uci -q get tgws.settings.enabled)" = "1" ] || {
        log "INFO service disabled, skipping"
        exit 0
    }
    [ "$(uci -q get tgws.settings.watchdog_enabled || echo 1)" = "1" ] || {
        log "INFO watchdog disabled, skipping"
        exit 0
    }

    local out rc ok fail okdom=""

    manage_worker

    out="$(probe)"
    rc=$?

    if [ "$rc" -ne 0 ] && ! echo "$out" | grep -q '^  kws'; then
        log "ERROR --check failed (rc=$rc), no domains probed"
        echo "$out" | tail -n 5 >> "$LOGFILE"
        exit 3
    fi

    # --check prints `  kws2.{domain} ... [OK ]  xxxms`; keep the bare
    # {domain} (strip the kws{N}.) so it is valid for --cf-domain
    okdom="$(echo "$out" | awk '/^  kws/ && /\[OK/ { d=$1; sub(/^kws[0-9]+\./, "", d); print d }')"

    ok="$(echo "$okdom" | grep -c . )"
    fail="$(echo "$out" | grep -c '\[FAIL')"

    log "INFO probe rc=$rc ok=$ok fail=$fail"

    if [ -z "$okdom" ]; then
        log "ERROR all domains failing, leaving config as-is"
        exit 2
    fi

    # keep up to MAX_KEEP healthy domains, in probe order
    newdom="$(echo "$okdom" | head -n "$MAX_KEEP" | tr '\n' ',' | sed 's/,$//')"
    curdom="$(uci -q get tgws.settings.cf_domain)"

    if [ "$newdom" != "$curdom" ]; then
        uci set tgws.settings.cf_domain="$newdom"
        uci commit tgws
        log "INFO cf_domain $curdom -> $newdom"
        /etc/init.d/tgws restart >/dev/null 2>&1
        log "INFO service restarted with new domain list"
        exit 1
    elif [ "$fail" -gt 0 ]; then
        log "INFO healthy set unchanged, some domains failing, restart"
        /etc/init.d/tgws restart >/dev/null 2>&1
        exit 1
    else
        log "INFO all domains OK, config up to date, no action"
        exit 0
    fi
}

main "$@"