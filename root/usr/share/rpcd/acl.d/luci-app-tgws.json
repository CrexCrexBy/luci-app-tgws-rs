{
	"luci-app-tgws": {
		"description": "Grant access to TG WS Proxy configuration",
		"read": {
			"ubus": {
				"luci.tgws": [ "getStatus", "getConfig", "getLink", "getLanIP",
					"getReleases", "getVersions", "getVersion", "getLogs", "getWatchdogLogs",
					"checkUpdate", "getSecret" ]
			},
			"uci": [ "tgws" ]
		},
		"write": {
			"ubus": {
				"luci.tgws": [ "saveConfig", "setAction", "setWatchdogAction", "generateSecret",
					"installVersion", "rollback" ]
			},
			"uci": [ "tgws" ],
			"file": {
				"/usr/bin/tg-ws-proxy": [ "read", "write" ]
			}
		}
	}
}
